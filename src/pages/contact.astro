---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title="Kontak - {SITE_TITLE}" description="Hubungi Mas Wahyu — Founder Qawwa Technology Indonesia." />
		<style>
			* { box-sizing: border-box; }
			body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #fffbf5 0%, #fff5eb 100%); color: #1a1a1a; font-size: 18px; line-height: 1.7; -webkit-font-smoothing: antialiased; }
			main { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem; }
			h1 { font-size: 2rem; font-weight: 700; margin: 0 0 1.5rem; color: #1a1a1a; }
			p { color: #444; margin: 0 0 1.5rem; }
			.contact-card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
			.contact-card .label { font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
			.contact-card .value { font-size: 1rem; color: #1a1a1a; }
			.contact-card a { color: #ea580c; text-decoration: none; }
			.contact-card a:hover { text-decoration: underline; }
			.social-links { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
			.social-links a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: white; border-radius: 8px; text-decoration: none; color: #444; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: all 0.2s; }
			.social-links a:hover { background: #fff7ed; color: #ea580c; transform: translateY(-1px); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Hubungi Saya</h1>
			<p>Ada pertanyaan, ide kolaborasi, atau butuh bantuan? Jangan ragu untuk menghubungi saya.</p>

			<div class="contact-card">
				<div class="label">Email</div>
				<div class="value"><a href="mailto:kangmaswahyu@gmail.com">kangmaswahyu@gmail.com</a></div>
			</div>

			<div class="contact-card">
				<div class="label">LinkedIn</div>
				<div class="value"><a href="https://www.linkedin.com/in/wahyu-widagdo-purnomo" target="_blank">linkedin.com/in/wahyu-widagdo-purnomo</a></div>
			</div>

			<div class="contact-card">
				<div class="label">Threads</div>
				<div class="value"><a href="https://www.threads.net/@maswahyu.me" target="_blank">@maswahyu.me</a></div>
			</div>

			<div class="contact-card">
				<div class="label">Website Perusahaan</div>
				<div class="value"><a href="https://qawwa.tech" target="_blank">qawwa.tech</a></div>
			</div>

			<div class="social-links">
				<a href="mailto:kangmaswahyu@gmail.com">📧 Email</a>
				<a href="https://www.linkedin.com/in/wahyu-widagdo-purnomo" target="_blank">💼 LinkedIn</a>
				<a href="https://www.threads.net/@maswahyu.me" target="_blank">🧵 Threads</a>
				<a href="https://qawwa.tech" target="_blank">🌐 Qawwa Tech</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
